<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Minimal hardened-runtime entitlements. Holler dlopen()s the Apple-signed
	  MediaRemote private framework; that's permitted under library validation
	  because it's signed by Apple, so no disable-library-validation is needed.
	  Network listening/browsing needs no entitlement outside the App Store sandbox.
	-->
</dict>
</plist>
